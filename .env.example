# Public site URL (used for canonical URLs, sitemap, Open Graph). Netlify exposes URL automatically; override if needed.
NEXT_PUBLIC_SITE_URL=https://raveoween-community.netlify.app

# Anonymous feedback relay (Slack/Discord/Zapier/etc). Receives ONLY { experience, feedback }. Leave empty to disable.
FEEDBACK_WEBHOOK_URL=

# --- Community phase (NOT used by the public site in this release) ---
# Keep false until auth, age verification and admin controls pass security acceptance.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Not read by any code in this release.
SUPABASE_SERVICE_ROLE_KEY=
